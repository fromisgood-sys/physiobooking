NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Supabase's own OAuth callback (Supabase dashboard > Authentication > URL
# Configuration), not something you set — paste it into Google Cloud
# Console's authorized redirect URIs. Looks like:
# https://<project-ref>.supabase.co/auth/v1/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RECEPTION_EMAIL=
NEXT_PUBLIC_CLINIC_TZ=Africa/Windhoek
NEXT_PUBLIC_APP_URL=
BOOKING_LEAD_TIME_MINUTES=60

# Local testing only (never on Vercel): enables /api/dev-login
# DEV_LOGIN_ENABLED=1

# Gmail SMTP: enable 2-step verification, create an App Password.
# Set these locally for localhost; Vercel variables are not available to local Next.js.
